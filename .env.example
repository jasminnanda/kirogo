# kirogo configuration. Copy to .env and edit.
# Only PROXY_API_KEY matters; everything else has a working default.
# Precedence: command line flags > real env vars > this file.
# Values are read verbatim, so KIRO_CREDS_FILE=D:\Kiro\creds.json works.

# --- Client auth ---------------------------------------------------------------

# Key your client must send, as "Authorization: Bearer <key>" or "x-api-key: <key>".
# Unset falls back to "kirogo" and warns: anyone reaching the port spends your quota.
PROXY_API_KEY=change-me-to-a-long-random-string

# --- Server --------------------------------------------------------------------

# Loopback by default. 0.0.0.0 exposes a live AWS token to your network.
#SERVER_HOST=127.0.0.1
#SERVER_PORT=8000

# --- Credentials ---------------------------------------------------------------

# Usually none of these are needed: sign into Kiro IDE once and kirogo finds the
# token. Order tried: KIRO_CREDS_FILE, REFRESH_TOKEN, ~/.aws/sso/cache, KIRO_CLI_DB_FILE.
# A KIRO_CREDS_FILE that is set but unusable is a hard error, not a fall-through.

#KIRO_CREDS_FILE=~/.aws/sso/cache/kiro-auth-token.json

# Standalone token. Prefer a file: there is nowhere to write a rotated token back to.
#REFRESH_TOKEN=

# kiro-cli database. Read only.
#KIRO_CLI_DB_FILE=~/.local/share/kiro-cli/data.sqlite3

# Read from your credentials. Set only if a request says it is missing.
#PROFILE_ARN=

# --- Regions -------------------------------------------------------------------

# Token refresh region.
#KIRO_REGION=us-east-1

# API region. Otherwise derived from profile ARN, then credentials, then KIRO_REGION.
#KIRO_API_REGION=

# --- Reasoning effort ----------------------------------------------------------

# Default effort: low, medium, high, xhigh, max. Unset means each model's own
# default. A level a model does not advertise is clamped to that default.
# "none" turns reasoning off, but only the gpt-5.6-* models offer it; on any other
# model it resolves to the lowest level that model does offer.
#KIRO_EFFORT_LEVEL=

# List "model:level" ids such as claude-opus-5:max in /v1/models. Clients that send
# only a model name have no other way to pick an effort.
#KIRO_EXPOSE_EFFORT_VARIANTS=true

# Catalog freshness, seconds.
#KIRO_MODEL_REFRESH_TTL=3600

# --- Upstream request shape ----------------------------------------------------

#KIRO_AGENT_MODE=vibe
#KIRO_VERSION=0.7.45

# inline = fold into the first user turn, the only placement the live backend
# honours. field = top-level systemPrompt, which the deployment currently rejects.
#KIRO_SYSTEM_PROMPT_MODE=inline

# --- Timeouts and limits -------------------------------------------------------

# Seconds to wait for the first token before retrying. Retries stop once any byte
# has reached your client, so a partial response is never restarted.
#FIRST_TOKEN_TIMEOUT=15
#FIRST_TOKEN_MAX_RETRIES=3

# Max gap between streamed chunks. Keep well above FIRST_TOKEN_TIMEOUT.
#STREAMING_READ_TIMEOUT=300

# Longer tool descriptions move to the system prompt; the backend rejects them
# inline. 0 disables, not recommended.
#TOOL_DESCRIPTION_MAX_LENGTH=10000

# Sanity guard, not the real ceiling. Measured: the backend accepts a 3.4MB request
# carrying 989k tokens, then answers with a clear "Context limit reached" of its own.
# Setting this low refuses requests the model could have served. kirogo never trims
# your history itself.
#KIRO_MAX_PAYLOAD_BYTES=4000000

# --- Logging -------------------------------------------------------------------

# DEBUG prints the exact upstream payload. Credentials are redacted at every level.
#LOG_LEVEL=INFO

# --- Proxies -------------------------------------------------------------------

# Standard HTTPS_PROXY, HTTP_PROXY and NO_PROXY are honoured. No SOCKS5.
#HTTPS_PROXY=http://127.0.0.1:7890
